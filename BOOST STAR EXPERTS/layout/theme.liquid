    <script>
      (function() {
        var loaded = false;
        window.__speedLazyloaded = false;
        function loadNonCritical() {
          if (loaded) return;
          loaded = true;
          window.__speedLazyloaded = true;
          
          // Dispatch global custom event for other deferred/lazy scripts (like GTM & Pixels)
          window.dispatchEvent(new CustomEvent('speed-lazyload'));
          
          document.querySelectorAll('[data-speed-src]').forEach(function(el) {
            el.setAttribute('src', el.getAttribute('data-speed-src'));
          });
          document.querySelectorAll('[data-speed-href]').forEach(function(el) {
            el.setAttribute('href', el.getAttribute('data-speed-href'));
          });
          ['touchstart', 'mouseover', 'scroll', 'mousemove', 'keydown'].forEach(function(evt) {
            window.removeEventListener(evt, loadNonCritical);
          });
        }
        
        // Backup timeout: load scripts automatically after 4 seconds if no user interaction occurred
        setTimeout(loadNonCritical, 4000);
        
        ['touchstart', 'mouseover', 'scroll', 'mousemove', 'keydown'].forEach(function(evt) {
          window.addEventListener(evt, loadNonCritical, { passive: true });
        });
      })();
    </script>
