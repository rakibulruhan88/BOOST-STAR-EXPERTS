  {%- comment -%} FL SEO: title — suppress on tagged collections where the metafield override outputs its own <title> {%- endcomment -%}
  {%- unless request.page_type == 'collection' and current_tags.size > 0 -%}
    {%- render 'seo-title' -%}
  {%- endunless -%}

  {%- comment -%} FL SEO: meta description with shop.description fallback {%- endcomment -%}
  {%- assign fl_meta_desc = page_description | default: shop.description -%}
  {%- if fl_meta_desc != blank -%}
    <meta name="description" content="{{ fl_meta_desc | strip_html | escape }}">
  {%- endif -%}

  {%- comment -%} FL SEO: noindex thin/colour collections, filtered URLs, tagged URLs {%- endcomment -%}
  {%- assign fl_thin_collections = 'dark,light,honey,natural,walnut,white,plank,looselay,lacquered,golden,red,green,pink,blue,merbau,unfinished,speckled-concrete,oak,pine,ash,beige,brown,grey,greige,copper,cream,black' | split: ',' -%}
  {%- if request.page_type == 'collection' -%}
    {%- assign fl_noindex = false -%}
    {%- if fl_thin_collections contains collection.handle -%}
      {%- assign fl_noindex = true -%}
    {%- endif -%}
    {%- if current_tags.size > 0 -%}
      {%- assign fl_noindex = true -%}
    {%- endif -%}
    {%- for filter in collection.filters -%}
      {%- if filter.active_values.size > 0 -%}
        {%- assign fl_noindex = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if fl_noindex -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} FL SEO: noindex specific discontinued product handles {%- endcomment -%}
  {%- if request.page_type == 'product' -%}
    {%- assign fl_noindex_handles = 'quickstep-vinyl-livyn-balance-glue-plus-select-oak-natural-bagp40033,quickstep-vinyl-livyn-balance-glue-plus-canyon-oak-light-with-saw-cuts-bagp40128,quickstep-arte-scotia,quickstep-livyn-vinyl-glue-qsvglue6' | split: ',' -%}
    {%- if fl_noindex_handles contains product.handle -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}
  {%- endif -%}
  {%- if request.path contains '/questions/tagged/' or template contains '404' -%}
    <meta name="robots" content="noindex, nofollow">
  {%- endif -%}

  {%- comment -%} Open Graph product:price and product:availability for Facebook product ads {%- endcomment -%}
  {%- if request.page_type == 'product' -%}
    <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | escape }}">
    <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
    <meta property="product:availability" content="{% if product.selected_or_first_available_variant.available %}in stock{% else %}out of stock{% endif %}">
  {%- endif -%}

  {%- comment -%} FL SEO: tag-based meta title/description from collection metafields (tagged collections only) {%- endcomment -%}
  {%- if request.page_type == 'collection' and current_tags.size > 0 -%}
    {%- assign fl_tag_handle = request.path | split: '/' | last -%}
    {%- assign fl_tag_title_found = false -%}
    {%- if collection.metafields.custom.metatitle != blank -%}
      {%- for fl_mt in collection.metafields.custom.metatitle.value -%}
        {%- assign fl_mt_parts = fl_mt | split: '||' -%}
        {%- assign fl_mt_handle = fl_mt_parts[0] | downcase | strip -%}
        {%- if fl_tag_handle == fl_mt_handle -%}
          <title>{{ fl_mt_parts[1] | strip }}</title>
          {%- assign fl_tag_title_found = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- comment -%} Fallback: if no metafield title found for this tag, output the standard title {%- endcomment -%}
    {%- unless fl_tag_title_found -%}
      {%- render 'seo-title' -%}
    {%- endunless -%}
    {%- if collection.metafields.custom.metadescription != blank -%}
      {%- for fl_md in collection.metafields.custom.metadescription.value -%}
        {%- assign fl_md_parts = fl_md | split: '||' -%}
        {%- assign fl_md_handle = fl_md_parts[0] | strip -%}
        {%- if fl_tag_handle == fl_md_handle -%}
          <meta name="description" content="{{ fl_md_parts[1] | strip | escape }}">
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}

